# Flare environment. Copy to .env and fill real values (never commit .env).
ENVIRONMENT=production
BASE_URL=https://flare.example.com

# Release and browser self-monitoring metadata. FLARE_RELEASE is the version;
# FLARE_COMMIT is an optional full lowercase Git SHA from a clean checkout.
# Set it in a trusted build pipeline to distinguish builds of one version.
# Without it /readyz reports an empty source_commit. FLARE_DSN is an
# ingest-only public credential for Flare's own dashboard bundle; never put API
# keys or provider secrets in these values. Leave FLARE_DSN empty to disable
# dashboard self-monitoring.
FLARE_RELEASE=development
FLARE_COMMIT=
FLARE_ENVIRONMENT=production
FLARE_DSN=

# Optional Stage proof verification for AI coding-loop receipts. The URL is
# operator-owned; project admins configure a scoped credential in Flare, not
# here. Set both values when Stage is reached through a private Tailscale IP.
# TLS still verifies the hostname in FLARE_STAGE_VERIFY_URL; the peer IP is
# one exact dial target, never a private-network allowlist.
FLARE_STAGE_VERIFY_URL=
FLARE_STAGE_VERIFY_PEER_IP=

# Optional administrator-led HubSpot app install. Register the exact redirect
# BASE_URL/api/connectors/hubspot/callback in a HubSpot developer app and grant
# only the oauth scope. Set both values to enable Connect HubSpot in Settings.
# The secret stays server-side; workspace administrators never paste it.
FLARE_HUBSPOT_OAUTH_CLIENT_ID=
FLARE_HUBSPOT_OAUTH_CLIENT_SECRET=

# Secrets. CSRF_KEY must be exactly 32 bytes; SESSION_KEY 32+ bytes.
# Generate: openssl rand -base64 24
SESSION_KEY=your_session_key_here_change_me
CSRF_KEY=your_csrf_key_32_bytes_change_me!
# FLARE_SECRET_KEY encrypts integration secrets at rest (BYOAI keys, OIDC client
# secrets, notification-channel configs). With ENVIRONMENT=production above,
# Flare REFUSES TO BOOT without it. Generate: openssl rand -base64 32
# Treat as permanent: rotating it makes existing encrypted values unreadable.
FLARE_SECRET_KEY=your_secret_key_here_change_me

# Registration. POST /api/auth/register is the FIRST-RUN path: it is open while
# the install has no users, and closes by itself once the first owner exists.
# Further members join by invite. Set this to true only where public signup is
# the product: with it on, anyone who can reach the instance can create an org,
# and every org carries its own INGEST_RATE_PER_MIN budget against the same
# Postgres, so ingest capacity grows with the number of orgs created.
# FLARE_ALLOW_SIGNUP=false

# Postgres. docker-compose composes DATABASE_URL from this password; override
# DATABASE_URL directly to point at an external Postgres instead.
FLARE_DB_PASSWORD=changeme_postgres
# DATABASE_URL=postgres://flare:changeme_postgres@flare-db:5432/flare?sslmode=disable

# Optional. Redis for ingest rate-limit / dedupe counters (graceful if unset).
REDIS_URL=

# Transactional email (alert delivery + password reset). Optional: leave
# SMTP_HOST/SMTP_FROM empty to run without email (those features no-op).
# Works with any SMTP server (self-host, mailhog in dev, Resend/SES in prod).
# SMTP_TLS: "tls" (implicit, port 465) | "starttls" (587) | "none" (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Flare
SMTP_TLS=starttls

# Telemetry retention (days). Aged partitions are exported to Parquet then dropped.
RETENTION_DAYS=30

# Cold-tier Parquet. Local dir by default (self-host with a mounted volume).
# To archive to S3/MinIO instead, set the S3 vars below.
FLARE_PARQUET_DIR=/app/data/parquet
# NOTE on right-to-erasure with an S3/MinIO cold tier: Flare erases the live
# database on a project or workspace deletion, but it CANNOT rewrite archived
# Parquet files in object storage. Those erasures come back 202 (partial), the
# UI says so, and the obligation is recorded in the pending_erasures table and
# re-logged on every start until an operator clears it. With a LOCAL cold tier
# (FLARE_PARQUET_DIR, no S3 endpoint) the purge is complete and automatic.
# FLARE_PARQUET_S3_ENDPOINT=s3.example.com
# FLARE_PARQUET_S3_BUCKET=flare
# FLARE_PARQUET_S3_ACCESS_KEY=changeme
# FLARE_PARQUET_S3_SECRET_KEY=changeme
# FLARE_PARQUET_S3_REGION=us-east-1
# FLARE_PARQUET_S3_USE_SSL=true
